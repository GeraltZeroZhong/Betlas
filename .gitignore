# Python/build/cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.cache/
build/
dist/
*.egg-info/
.venv-evolocity/
.venv*/
venv/
env/

# Local agents and editor/runtime state
.agents/
.codex/

# Internal generated runs and temporary work
runs/
outputs/
eval_outputs/
**/tmp/
**/cache/
**/caches/
**/foldseek_tmp/
**/dssp_cache/

# Data boundary: publish curated release assets separately
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/README.md
data/readouts/**
data/audit/**
data/external/**
data/manifest*.json
data/source_snapshot*.json

# Large/generated external database artifacts
**/*fsdb*
**/*.dbtype
**/*.index
**/*.lookup
**/*.h3f
**/*.h3i
**/*.h3m
**/*.h3p

# Non-public documentation snapshots and archives
docs/
scripts/archive/
scripts/archive*/
scripts/internal/
scripts/**/.conda/
scripts/**/downloads/
scripts/**/runs/
scripts/**/tools/
scripts/external_baselines/**/.conda/
scripts/external_baselines/**/downloads/
scripts/external_baselines/**/runs/
scripts/external_baselines/**/tools/
figures/_archive/
figures/audit/
figures/unified_figures/**/source_data/retired/

# Figure build/session artifacts not meant for public repository history
*.pse
figures/publication_main_v2/**/source_data/*__source_map.csv
figures/publication_main_v2/source_inputs/
figures/publication_main_v2/**/structure_inputs/
figures/publication_main_v2/case_study_structure_render_manifest.csv

# Manuscript, figure and data release assets are managed outside this code repository
manuscript/
figures/
data/

# Public asset manifests are tracked; heavy release payloads are external.
assets/**/files/
assets/**/*.npz
assets/**/*.pkl
assets/**/*.pt
assets/**/*.ckpt
assets/**/*.h5
assets/**/*.hdf5
